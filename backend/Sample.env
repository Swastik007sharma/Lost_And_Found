# 🌩️ Cloudinary Configuration

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

## 🔐 JWT Configuration

JWT_SECRET=your_jwt_secret_key # Use a strong, random secret
JWT_EXPIRES_IN=1d

## 🗄️ Database Configuration

MONGODB_URI=your_mongodb_connection_uri

# ## 📧 Email Configuration (Resend)

# RESEND_API_KEY=your_resend_api_key # Get from https://resend.com/api-keys
# RESEND_FROM_EMAIL=onboarding@resend.dev # Your verified sender email

# ========== OLD EMAIL CONFIGURATION (NODEMAILER - COMMENTED OUT) ==========
# EMAIL_USER=<your_email@gmail.com> # Use an actual Gmail address
# EMAIL_PASSWORD=your_app_password # Use Gmail App Password (not regular password)
# ========== END OF OLD EMAIL CONFIGURATION ==========

MAILSERVER_URL=http://localhost:8000/send-email 
# refer: https://github.com/Swastik007sharma/MailServer for setting up your own mail server

## 🌐 CORS Configuration

FRONTEND_URL=<http://localhost:3000>
ALLOWED_ORIGINS=<http://localhost:3000,https://your-production-frontend.com,http://localhost>,\*

## 🚦 Rate Limiting Configuration

RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

## 📁 File Upload Configuration

UPLOADS_FOLDER=./uploads

## 📜 Logging Configuration

LOG_FILE_PATH=./logs/access.log

## 🤖 AI Image Analysis (Gemini)

# Enable/disable Gemini image verification during item creation.
# true  -> run Gemini verification workflow
# false -> skip Gemini workflow and upload directly to Cloudinary
ENABLE_GEMINI_ANALYSIS=false

# Required only when ENABLE_GEMINI_ANALYSIS=true
GEMINI_API_KEY=your_gemini_api_key

## ⚙️ Application Settings

PORT=5000
NODE_ENV=development

<!-- # 🗑️ Automatic Cleanup Configuration

# User Deletion Strategy (default: 'deactivation')

# - 'deactivation': Delete users after X days of being deactivated (isActive = false)

# - 'inactivity': Delete users after X days of no login activity -->

USER_DELETION_STRATEGY=deactivation

## Number of days of inactivity/deactivation before marking for deletion (default: 60)

INACTIVITY_DAYS=60

## Grace period in days before permanent deletion after being marked (default: 7)

GRACE_PERIOD_DAYS=7
